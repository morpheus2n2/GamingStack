<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="GamingStackGUI.app"/>

  <!-- asInvoker (the default) - deliberately NOT requireAdministrator here.
       This is Debug-only: dotnet run/F5 launch the app via CreateProcess, which
       cannot silently elevate a child process the way double-clicking an exe
       (ShellExecute) can - requesting requireAdministrator here causes
       "the requested operation requires elevation" on every debug run.
       Registry/tweak code that needs admin will just fail gracefully in Debug;
       test that part via a Release publish, or by running VS Code itself as
       Administrator. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- High-DPI is set via Application.SetHighDpiMode(...) in Program.cs instead of
       here - declaring it in both places trips WFAC010, so this stays out of the
       manifest on purpose. -->

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
